[
    {config, [
        #{
            files => ["src/**/*.erl"],
            rules => [
                %% Keep
                {elvis_style, no_macros, disable},
                {elvis_style, atom_naming_convention, #{
                    regex => "^[a-z](_?[a-zA-Z0-9]+)*(_SUITE)?$"
                }},
                %% Since OTP28
                {elvis_style, prefer_strict_generators, disable},
                %% New in elvis_core 5.x - disable for now
                {elvis_style, prefer_sigils, disable},
                {elvis_style, consistent_ok_error_spec, disable},
                {elvis_style, abc_size, disable},
                {elvis_style, code_complexity, disable},
                {elvis_style, consistent_variable_naming, disable},
                %% Disable rules that are too strict for this codebase
                {elvis_style, no_common_caveats_call, disable},
                {elvis_style, no_init_lists, disable},
                {elvis_style, no_spec_with_records, disable},
                {elvis_style, param_pattern_matching, disable},
                {elvis_style, no_used_ignored_variables, disable},
                {elvis_text_style, max_line_length, #{limit => 120}},
                %% Relaxed for the initial lint adoption; tighten later.
                %% `no_invalid_dynamic_calls' fires on the pluggable
                %% handler dispatch (HandlerMod:accept/1 etc.) that the
                %% server modules are built around; `no_throw' covers
                %% the throw-based capsule/URI parsers.
                {elvis_style, dont_repeat_yourself, disable},
                {elvis_style, no_invalid_dynamic_calls, disable},
                {elvis_style, no_if_expression, disable},
                {elvis_style, guard_operators, disable},
                {elvis_style, no_throw, disable},
                {elvis_style, no_deep_nesting, disable},
                {elvis_style, no_boolean_in_comparison, disable},
                {elvis_style, no_single_clause_case, disable},
                %% Narrow, per-module relaxations.
                {elvis_style, private_data_types, #{
                    ignore => [masque, masque_ip_capsule]
                }},
                {elvis_style, export_used_types, #{
                    ignore => [masque_udp_bind_proxy_handler]
                }},
                {elvis_style, no_receive_without_timeout, #{
                    ignore => [masque_racer]
                }},
                {elvis_style, no_god_modules, #{
                    limit => 30,
                    ignore => [masque]
                }}
            ],
            ruleset => erl_files
        },
        #{
            files => ["include/*.hrl"],
            ruleset => hrl_files
        },
        #{
            files => ["rebar.config"],
            ruleset => rebar_config
        }
    ]}
].
