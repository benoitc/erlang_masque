{application, masque, [
    {description,
        "MASQUE for Erlang: CONNECT-UDP, CONNECT-IP, CONNECT-TCP and Connect-UDP-Bind over HTTP/3, HTTP/2 and HTTP/1.1"},
    {vsn, "0.8.0"},
    {registered, [masque_sup]},
    {mod, {masque_app, []}},
    {applications, [
        kernel,
        stdlib,
        ssl,
        crypto,
        public_key,
        quic,
        h2,
        h1,
        instrument
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/benoitc/erlang_masque"}]}
]}.
