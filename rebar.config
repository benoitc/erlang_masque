{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {quic, "2.0.1"},
    {h2, "0.12.3"},
    {h1, "0.9.1", {pkg, erlang_h1}},
    {instrument, "1.1.5"}
]}.

{project_plugins, [
    rebar3_ex_doc,
    rebar3_hex,
    {rebar3_lint, "~> 5.0"},
    {erlfmt, "~> 1.7"}
]}.

{hex, [{doc, ex_doc}]}.

{erlfmt, [
    write,
    {files, [
        "{src,include,test,examples}/**/*.{hrl,erl,app.src}",
        "rebar.config"
    ]}
]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}},
        {"docs/1-understand/overview.md", #{title => "What masque is"}},
        {"docs/1-understand/concepts.md", #{title => "Concepts"}},
        {"docs/1-understand/architecture.md", #{title => "Architecture"}},
        {"docs/2-use/getting-started.md", #{title => "Getting started"}},
        {"docs/2-use/client.md", #{title => "Client"}},
        {"docs/2-use/server.md", #{title => "Server"}},
        {"docs/2-use/handlers.md", #{title => "Handlers"}},
        {"docs/2-use/connect-udp.md", #{title => "CONNECT-UDP"}},
        {"docs/2-use/connect-tcp.md", #{title => "CONNECT-TCP"}},
        {"docs/2-use/connect-ip.md", #{title => "CONNECT-IP"}},
        {"docs/2-use/connect-udp-bind.md", #{title => "Connect-UDP-Bind"}},
        {"docs/2-use/relay.md", #{title => "Building a relay"}},
        {"docs/2-use/operations.md", #{title => "Operations"}},
        {"CONTRIBUTING.md", #{title => "Contributing"}},
        {"docs/3-change/code-map.md", #{title => "Code map"}},
        {"docs/3-change/server-internals.md", #{title => "Server internals"}},
        {"docs/3-change/client-internals.md", #{title => "Client internals"}},
        {"docs/3-change/transports.md", #{title => "Transports"}},
        {"docs/3-change/pool.md", #{title => "Upstream pool"}},
        {"docs/3-change/connect-ip-internals.md", #{title => "CONNECT-IP internals"}},
        {"docs/3-change/udp-bind-internals.md", #{title => "Connect-UDP-Bind internals"}},
        {"docs/3-change/testing.md", #{title => "Testing"}},
        {"docs/3-change/debugging.md", #{title => "Debugging"}},
        {"docs/3-change/how-to.md", #{title => "How to..."}},
        {"docs/3-change/decisions.md", #{title => "Design decisions"}},
        {"docs/3-change/releasing.md", #{title => "Releasing"}},
        {"docs/reference/messages-and-errors.md", #{title => "Messages and errors"}},
        {"docs/reference/conformance.md", #{title => "RFC conformance"}},
        {"CHANGELOG.md", #{title => "Changelog"}},
        {"LICENSE", #{title => "License"}}
    ]},
    {groups_for_extras, [
        {"Understand", [
            <<"docs/1-understand/overview.md">>,
            <<"docs/1-understand/concepts.md">>,
            <<"docs/1-understand/architecture.md">>
        ]},
        {"Use", [
            <<"docs/2-use/getting-started.md">>,
            <<"docs/2-use/client.md">>,
            <<"docs/2-use/server.md">>,
            <<"docs/2-use/handlers.md">>,
            <<"docs/2-use/connect-udp.md">>,
            <<"docs/2-use/connect-tcp.md">>,
            <<"docs/2-use/connect-ip.md">>,
            <<"docs/2-use/connect-udp-bind.md">>,
            <<"docs/2-use/relay.md">>,
            <<"docs/2-use/operations.md">>
        ]},
        {"Change", [
            <<"CONTRIBUTING.md">>,
            <<"docs/3-change/code-map.md">>,
            <<"docs/3-change/server-internals.md">>,
            <<"docs/3-change/client-internals.md">>,
            <<"docs/3-change/transports.md">>,
            <<"docs/3-change/pool.md">>,
            <<"docs/3-change/connect-ip-internals.md">>,
            <<"docs/3-change/udp-bind-internals.md">>,
            <<"docs/3-change/testing.md">>,
            <<"docs/3-change/debugging.md">>,
            <<"docs/3-change/how-to.md">>,
            <<"docs/3-change/decisions.md">>,
            <<"docs/3-change/releasing.md">>
        ]},
        {"Reference", [
            <<"docs/reference/messages-and-errors.md">>,
            <<"docs/reference/conformance.md">>,
            <<"CHANGELOG.md">>,
            <<"LICENSE">>
        ]}
    ]},
    {groups_for_modules, [
        {"Public API", [masque]},
        {"Handlers", [
            masque_handler,
            masque_udp_proxy_handler,
            masque_tcp_proxy_handler,
            masque_ip_proxy_handler,
            masque_udp_bind_proxy_handler,
            masque_chain_handler
        ]},
        {"Codecs", [
            masque_datagram,
            masque_capsule,
            masque_ip_capsule,
            masque_compression_capsule,
            masque_compression_table,
            masque_udp_bind_payload,
            masque_ip_packet,
            masque_icmp
        ]},
        {"URI templates", [
            masque_uri,
            masque_uri_template,
            masque_uri_ip,
            masque_uri_udp_bind
        ]},
        {"Support", [
            masque_ip,
            masque_metrics,
            masque_errors
        ]}
    ]},
    {before_closing_body_tag, #{html => ""}},
    {with_mermaid, true},
    {main, "README.md"},
    {source_url, "https://github.com/benoitc/erlang_masque"},
    {output, "doc"}
]}.

{profiles, [
    {test, [
        {deps, [{proper, "1.5.0"}]},
        {plugins, [{rebar3_proper, "0.12.1"}]},
        {erl_opts, [debug_info]},
        %% Compile the example modules under test so CT suites can
        %% exercise them without the reader having to `c(...)' by hand.
        {extra_src_dirs, ["examples"]}
    ]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{dialyzer, [
    {warnings, [
        error_handling,
        unmatched_returns
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
